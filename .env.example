# Copie para .env e ajuste. Nunca commite o .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://journey:journey@localhost:5433/journey

# Segredo compartilhado com o provedor de leads para assinar os webhooks (HMAC-SHA256)
WEBHOOK_SECRET=troque-este-segredo

# CRM falso (docker compose sobe em http://fake-crm:4000)
CRM_BASE_URL=http://localhost:4000

# Opcional: alertas de falha do job de sincronização
DISCORD_WEBHOOK_URL=
