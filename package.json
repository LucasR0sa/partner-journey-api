{
  "name": "partner-journey-api",
  "version": "0.1.0",
  "description": "API que acompanha cada parceiro do lead ao resultado: webhooks idempotentes, matching lead → cadastro e sincronização de produção com retry e alertas.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx tools/seed.ts",
    "sync": "node --env-file-if-exists=.env --import tsx src/jobs/run-sync.ts",
    "fake-crm": "tsx tools/fake-crm.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
